From 1d8f7a6901cbf91e71fd897ae283ff732a36a3d4 Mon Sep 17 00:00:00 2001
From: tsk-go <cmc686@gmail.com>
Date: Thu, 12 Nov 2026 08:34:12 -0500
Subject: [PATCH 2/2] Map speed limits with the phone GPS handoff:
 MapdOut.GpsSource phone, its age limit in map_source

---
 CLAUDE.md                                       | 11 +++++++++++
 openpilot/cereal/custom.capnp                   |  1 +
 openpilot/starpilot/speed_limits/map_source.py  |  4 +++-
 .../speed_limits/tests/test_map_source.py       | 17 +++++++++++++++++
 4 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/CLAUDE.md b/CLAUDE.md
index c3d29502..56ccd1ca 100644
--- a/CLAUDE.md
+++ b/CLAUDE.md
@@ -120,6 +120,15 @@ normal commit (no revert of history, no force-push) and tell the owner which one
    ever settles and every step rescans every drive folder (~960 routes, `owns_recording` per file): 63 % of a core over
    a 15-min drive (Nov 3). Upstream fixed = the uploader stops rescanning settled-but-failing routes, or has its own
    "uploads off" switch we can set from offline mode.
+6. **Map speed limits never arrive with the phone GPS handoff** (patch 74): in `openpilot/cereal/custom.capnp`
+   `MapdOut.GpsSource` `phone @4`, in `openpilot/starpilot/speed_limits/map_source.py` the 'phone' entry of
+   `GPS_MAX_AGE_NS` (10 s, mapd's own `phoneFixMaxAge`), and `test_phone_gps_handoff_is_read_and_kept_by_its_own_age`
+   in `speed_limits/tests/test_map_source.py`. mapd (Go) writes its `GpsSourcePhone` (4) when it runs on the phone GPS
+   handoff (StarView's RTK receiver, fork history 16: Galaxy's GPS source "Prefer phone GPS", or "backup" without the
+   comma's own fix); the Python schema had no 4, so `str(road.gpsSource)` raised and `copy_frame` dropped every frame -
+   mapd matched the road and its limit, the speed-limit side stayed `unknown` (Nov 11). Upstream fixed = upstream's
+   schema has the phone source and map_source accepts it. (mapd_repo's own schema copy is left as it is: Go writes the
+   number either way.)
 
 # Fork history
 
@@ -424,6 +433,8 @@ Paths are under `openpilot/` unless noted.
 18. A full update shows "failed" after its own reboot (patch 29): `system/updated/updated.py` `recover_fast_state`.
 31. The comma four restarts all night after a parked shutdown (patch 50): a marker in /data/starview from the parked
     shutdown makes a CAN wake with no drive since shut down again after 2 minutes instead of an hour; a drive clears it.
+43. Map speed limits with the phone GPS handoff (patch 74): `MapdOut.GpsSource` `phone @4` and map_source's 'phone'
+    age limit, so mapd's matches made on the RTK fix reach the speed-limit side.
 
 **No longer carried**
 - Lane Centering with one line (patch 37, with StarView's one-line tile and blue lines): dropped by the owner at the Oct 26
diff --git a/openpilot/cereal/custom.capnp b/openpilot/cereal/custom.capnp
index 8c74b400..fb8812b5 100644
--- a/openpilot/cereal/custom.capnp
+++ b/openpilot/cereal/custom.capnp
@@ -1210,6 +1210,7 @@ struct MapdOut @0xa4f1eb3323f5f582 {
     internal @1;
     external @2;
     car @3;
+    phone @4;  # mapd's GpsSourcePhone: the phone GPS handoff (StarView's RTK receiver writes it); mapd already sends 4
   }
 
   enum RoadContext @0xabefa88b9563dbae {
diff --git a/openpilot/starpilot/speed_limits/map_source.py b/openpilot/starpilot/speed_limits/map_source.py
index c312fc4a..9607e1f9 100644
--- a/openpilot/starpilot/speed_limits/map_source.py
+++ b/openpilot/starpilot/speed_limits/map_source.py
@@ -13,7 +13,9 @@ from openpilot.starpilot.speed_limits import acceptance as acc
 
 EVENT_MAX_AGE_NS = 250_000_000
 COMPUTED_MAX_AGE_NS = 250_000_000
-GPS_MAX_AGE_NS = {'external': 500_000_000, 'internal': 2_000_000_000, 'car': 2_500_000_000}
+# 'phone': the phone GPS handoff (Galaxy's GPS source "Prefer phone GPS" / "backup"); mapd's own limit for it
+# (phoneFixMaxAge in mapd_repo/cereal/gps.go), so a frame mapd matched is never thrown away here as stale.
+GPS_MAX_AGE_NS = {'external': 500_000_000, 'internal': 2_000_000_000, 'car': 2_500_000_000, 'phone': 10_000_000_000}
 MAX_EVENT_BYTES = 2 * 1024 * 1024
 MAX_RETIRED_SESSIONS = 16
 MAX_UINT64 = (1 << 64) - 1
diff --git a/openpilot/starpilot/speed_limits/tests/test_map_source.py b/openpilot/starpilot/speed_limits/tests/test_map_source.py
index d9c577e2..f050ebc7 100644
--- a/openpilot/starpilot/speed_limits/tests/test_map_source.py
+++ b/openpilot/starpilot/speed_limits/tests/test_map_source.py
@@ -52,6 +52,23 @@ class MapSourceTests(unittest.TestCase):
     self.assertIsNone(result.observation.candidate)
     self.assertEqual(ms.MapTracker().step(frame, received=True, now_boot_ns=now+1).kind, 'stale')
 
+  def test_phone_gps_handoff_is_read_and_kept_by_its_own_age(self):
+    # mapd writes gpsSource 4 (GpsSourcePhone) while Galaxy's GPS source uses the phone handoff; before `phone @4`
+    # str() of it raised and every such frame was dropped, so map speed limits never arrived (Nov 11)
+    fixture = json.loads((ROOT / 'mapd_repo/cereal/testdata/mapd_v1_wire.json').read_text())
+    from openpilot.cereal import log
+    with log.Event.from_bytes(base64.b64decode(fixture['event_base64'])) as event:
+      builder = event.as_builder()
+    builder.mapdOut.gpsSource = 'phone'
+    builder.mapdOut.sampleVersion = 2
+    frame = ms.decode_event(builder.to_bytes())
+    self.assertEqual(frame.source, 'phone')
+    now = frame.gps_mono_ns + 9_000_000_000
+    frame = replace(frame, event_mono_ns=now - 10_000_000, computed_mono_ns=now - 20_000_000)
+    self.assertEqual(ms.MapTracker().step(frame, received=True, now_boot_ns=now).kind, 'matched_limit_unqualified')
+    self.assertEqual(ms.MapTracker().step(frame, received=True, now_boot_ns=frame.gps_mono_ns + 10_000_000_001).kind,
+                     'stale')
+
   def test_real_provider_and_historical_wire_are_copied_immutably(self):
     frame = v2_frame()
     self.assertEqual((frame.version, frame.status, frame.source), (2, 'matchedLimit', 'external'))
