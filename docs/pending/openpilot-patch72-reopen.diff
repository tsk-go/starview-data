index cc81c3e4..a168f161 100644
--- a/openpilot/starpilot/system/starview/starviewd.py
+++ b/openpilot/starpilot/system/starview/starviewd.py
@@ -1237,6 +1237,7 @@ class Hub:
       connected = bool(self.data_clients)
     if connected:
       self._tablet_seen = now
+    self._reopen_check(now, connected)
     # Parked: hold 30 s through app switches / reconnects (every drop used to light the comma screen up again).
     # Driving: no hold, so the comma screen comes back within ~5 s (the UI's staleness limit) if the tablet dies.
     hold_s = 0.0 if (self.started or self._onroad()) else 30.0
@@ -1253,6 +1254,45 @@ class Hub:
     except OSError:
       pass
 
+  REOPEN_AFTER_S = 8.0     # no tablet connection this long with the car on -> look whether StarView is gone
+  REOPEN_EVERY_S = 20.0
+  REOPEN_TRIES = 5
+
+  def _reopen_check(self, now, connected):
+    """StarView back on the tablet when it disappeared while the car is on: it updated itself (Android closes an app to
+    replace it and doesn't open it again) or crashed. Only after a tablet was connected in the last 5 min, only while
+    started and in tablet mode, and only when StarView's process is gone (a driver who switched to another app keeps
+    it - the connection drops then too). Every 20 s, 5 tries per drop, in a thread (adb can take seconds)."""
+    if connected or not (self.started and self.tablet_mode):
+      self._reopen_tries = 0
+      return
+    gone = now - getattr(self, "_tablet_seen", -1e9)
+    if gone < self.REOPEN_AFTER_S or gone > 300.0 or getattr(self, "_reopen_tries", 0) >= self.REOPEN_TRIES:
+      return
+    if now - getattr(self, "_reopen_t", -1e9) < self.REOPEN_EVERY_S or getattr(self, "_reopen_busy", False):
+      return
+    if shutil.which("adb") is None or not os.path.isdir(ADB_HOME):
+      return
+    self._reopen_t = now
+    self._reopen_tries = getattr(self, "_reopen_tries", 0) + 1
+    self._reopen_busy = True
+
+    def run():
+      try:
+        r = _adb("shell", "pidof", STARVIEW_PKG)
+        if r is None:
+          return                              # tablet not reachable over adb
+        if r.stdout.strip():
+          self._reopen_tries = self.REOPEN_TRIES   # still running (the driver went to another app): leave it
+          return
+        awake = _tablet_awake()
+        cloudlog.warning(f"starview: StarView gone with the car on -> tablet: {_tablet_wake(bool(awake))}")
+      except Exception as e:
+        cloudlog.warning(f"starview: reopen: {e}")
+      finally:
+        self._reopen_busy = False
+    threading.Thread(target=run, name="starview-reopen", daemon=True).start()
+
   # ---- drive replay ----
   def _replaying(self) -> bool:
     r = getattr(self, "replay", None)
diff --git a/openpilot/starpilot/system/starview/tests/test_reopen.py b/openpilot/starpilot/system/starview/tests/test_reopen.py
new file mode 100644
index 00000000..85e42ebc
--- /dev/null
+++ b/openpilot/starpilot/system/starview/tests/test_reopen.py
@@ -0,0 +1,58 @@
+from types import SimpleNamespace
+
+from openpilot.starpilot.system.starview import starviewd
+
+
+class SyncThread:
+  def __init__(self, target=None, **kw):
+    self.target = target
+
+  def start(self):
+    self.target()
+
+
+def make(monkeypatch, pid=""):
+  calls = []
+  monkeypatch.setattr(starviewd.threading, "Thread", SyncThread)
+  monkeypatch.setattr(starviewd.shutil, "which", lambda name: "/usr/bin/adb")
+  monkeypatch.setattr(starviewd.os.path, "isdir", lambda p: True)
+  monkeypatch.setattr(starviewd, "_adb", lambda *a, **k: calls.append(a) or SimpleNamespace(stdout=pid))
+  monkeypatch.setattr(starviewd, "_tablet_awake", lambda: True)
+  monkeypatch.setattr(starviewd, "_tablet_wake", lambda awake: calls.append(("wake", awake)) or "started")
+  hub = object.__new__(starviewd.Hub)
+  hub.started = True
+  hub.tablet_mode = True
+  hub._tablet_seen = 100.0
+  return hub, calls
+
+
+def test_reopens_when_starview_is_gone_with_the_car_on(monkeypatch):
+  hub, calls = make(monkeypatch)
+  hub._reopen_check(105.0, False)                     # 5 s: not yet
+  assert calls == []
+  hub._reopen_check(109.0, False)                     # 9 s: StarView's process gone -> started again
+  assert ("shell", "pidof", starviewd.STARVIEW_PKG) in calls and ("wake", True) in calls
+  calls.clear()
+  hub._reopen_check(115.0, False)                     # at most every 20 s
+  assert calls == []
+  hub._reopen_check(130.0, False)
+  assert ("wake", True) in calls
+
+
+def test_leaves_starview_alone_when_its_process_still_runs(monkeypatch):
+  hub, calls = make(monkeypatch, pid="12345\n")       # the driver switched to another app
+  hub._reopen_check(109.0, False)
+  assert ("wake", True) not in calls
+  calls.clear()
+  hub._reopen_check(140.0, False)                     # no more tries for this drop
+  assert calls == []
+
+
+def test_nothing_parked_connected_or_long_gone(monkeypatch):
+  hub, calls = make(monkeypatch)
+  hub.started = False
+  hub._reopen_check(109.0, False)
+  hub.started = True
+  hub._reopen_check(109.0, True)                      # connected
+  hub._reopen_check(500.0, False)                     # gone more than 5 min (tablet off / unplugged)
+  assert calls == []
